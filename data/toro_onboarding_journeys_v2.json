{
  "version": "2026.09.23-v2",
  "status": "specified_not_runtime_verified",
  "principles": {
    "value_before_setup": true,
    "max_choices_per_turn": 3,
    "free_text_always_allowed": true,
    "known_facts_are_not_reasked": true,
    "optional_steps_skippable": true,
    "onboarding_does_not_block_normal_product": true,
    "role_specific_shortcuts_after_first_value": true,
    "restart_preserves_canonical_state": true
  },
  "shared_controls": {
    "home": [
      "0",
      "inicio",
      "menú"
    ],
    "back": [
      "9",
      "atrás"
    ],
    "skip": [
      "saltar",
      "después",
      "ahora no"
    ],
    "resume": [
      "continuar",
      "seguir"
    ],
    "help": [
      "ayuda"
    ]
  },
  "journeys": {
    "owner_admin": {
      "applies_to": [
        "GENERAL_MANAGER",
        "ADMIN_MANAGER",
        "ADMIN"
      ],
      "purpose": "Reach one owner-level useful outcome quickly, then expand TORO around the business.",
      "steps": [
        {
          "key": "welcome",
          "message": "Hola, {first_name}. TORO puede empezar pequeño y crecer contigo. No necesitas configurar todo hoy.",
          "prompt": "¿Qué te gustaría mejorar primero?",
          "choices": [
            {
              "key": "customers",
              "emoji": "💬",
              "label": "Clientes y ventas"
            },
            {
              "key": "operations",
              "emoji": "🏨",
              "label": "Operación y equipo"
            },
            {
              "key": "control",
              "emoji": "💰",
              "label": "Control y dinero"
            }
          ],
          "free_text": "O dime con tus palabras qué te quita más tiempo."
        },
        {
          "key": "context_confirm",
          "message": "Ya tengo {business_name} como contexto. Solo te preguntaré lo que falte para el objetivo que elegiste.",
          "prompt": "¿Quieres usar ese negocio ahora?",
          "choices": [
            {
              "key": "yes",
              "emoji": "✅",
              "label": "Sí, continuar"
            },
            {
              "key": "switch",
              "emoji": "🔄",
              "label": "Cambiar contexto"
            },
            {
              "key": "personal",
              "emoji": "👤",
              "label": "Ir a Personal"
            }
          ]
        },
        {
          "key": "minimum_connection",
          "message": "Para darte valor primero, conectamos únicamente lo necesario para este objetivo.",
          "prompt": "¿Cómo prefieres seguir?",
          "choices": [
            {
              "key": "use_connected",
              "emoji": "🔌",
              "label": "Usar lo conectado"
            },
            {
              "key": "connect_needed",
              "emoji": "➕",
              "label": "Conectar lo necesario"
            },
            {
              "key": "demo_first",
              "emoji": "▶️",
              "label": "Ver ejemplo primero"
            }
          ]
        },
        {
          "key": "first_value",
          "message": "Perfecto. TORO prepara el primer resultado y después te muestra solo 2–3 siguientes pasos útiles.",
          "prompt": "Después puedes seguir por número, palabra o escribiendo normal.",
          "completion": "first_useful_outcome_attempted"
        }
      ],
      "after_first_value": [
        "executive.brief",
        "executive.decisions",
        "finance.exceptions"
      ]
    },
    "manager_lead": {
      "applies_to": [
        "RECEPTION_OPS_LEAD",
        "JEFE_DEPARTAMENTO",
        "GERENCIA"
      ],
      "purpose": "Orient the manager around today's exceptions, team and guest/service impact.",
      "steps": [
        {
          "key": "welcome",
          "message": "Hola, {first_name}. Ya sé que estás en {business_name} y te voy a mostrar primero lo que necesita coordinación.",
          "prompt": "¿Qué quieres revisar?",
          "choices": [
            {
              "key": "today",
              "emoji": "☀️",
              "label": "Hotel hoy"
            },
            {
              "key": "team",
              "emoji": "👥",
              "label": "Equipo"
            },
            {
              "key": "pending",
              "emoji": "⚠️",
              "label": "Pendientes"
            }
          ]
        },
        {
          "key": "first_value",
          "message": "TORO te muestra excepciones y siguientes acciones; no una lista de todo el sistema.",
          "completion": "manager_exception_view_opened"
        }
      ],
      "after_first_value": [
        "operations.hotel_today",
        "people.coverage",
        "operations.exceptions"
      ]
    },
    "reception": {
      "applies_to": [
        "RECEPTION"
      ],
      "purpose": "Get reception to a guest-facing action in one or two turns.",
      "steps": [
        {
          "key": "welcome",
          "message": "Hola, {first_name} 👋 Ya sé que estás en Recepción. Puedes trabajar conmigo como si fuera una compañera que tiene el contexto del hotel.",
          "prompt": "¿Con qué empezamos?",
          "choices": [
            {
              "key": "arrivals",
              "emoji": "🛎️",
              "label": "Ver llegadas"
            },
            {
              "key": "messages",
              "emoji": "💬",
              "label": "Responder huéspedes"
            },
            {
              "key": "quote",
              "emoji": "💵",
              "label": "Cotizar"
            }
          ],
          "free_text": "O escribe algo como “problema en la 26” o “qué le recomiendo a esta pareja”."
        },
        {
          "key": "first_value",
          "message": "Después de resolverlo, TORO te deja listo el siguiente paso y mantiene el contexto de la conversación.",
          "completion": "reception_first_guest_action_attempted"
        }
      ],
      "after_first_value": [
        "guest.arrivals_departures",
        "comms.guest_messages",
        "hospitality.quote"
      ]
    },
    "housekeeping": {
      "applies_to": [
        "HOUSEKEEPING"
      ],
      "purpose": "Make the employee immediately understand today's work without teaching software.",
      "steps": [
        {
          "key": "welcome",
          "message": "Hola, {first_name} ☀️ Ya sé que estás en Aseo. No necesitas aprender el sistema completo.",
          "prompt": "¿Qué necesitas ahora?",
          "choices": [
            {
              "key": "next",
              "emoji": "🎯",
              "label": "Qué hago ahora"
            },
            {
              "key": "rooms",
              "emoji": "🧹",
              "label": "Mis habitaciones"
            },
            {
              "key": "issue",
              "emoji": "⚠️",
              "label": "Reportar problema"
            }
          ],
          "free_text": "También puedes mandar una foto o decirme qué encontraste."
        },
        {
          "key": "first_value",
          "message": "Cuando termines algo, TORO te propone la siguiente habitación o te ayuda a reportar lo que impide dejarla lista.",
          "completion": "housekeeping_first_action_attempted"
        }
      ],
      "after_first_value": [
        "housekeeping.priority",
        "housekeeping.assigned_units",
        "maintenance.report"
      ]
    },
    "maintenance": {
      "applies_to": [
        "MAINTENANCE"
      ],
      "purpose": "Put field priorities and proof-of-ready first.",
      "steps": [
        {
          "key": "welcome",
          "message": "Hola, {first_name} 🔧 Ya sé que estás en Mantenimiento. Primero va lo que puede afectar una llegada o la operación.",
          "prompt": "¿Qué quieres hacer?",
          "choices": [
            {
              "key": "priority",
              "emoji": "🔧",
              "label": "Ver prioridad"
            },
            {
              "key": "tasks",
              "emoji": "🧰",
              "label": "Mis tareas"
            },
            {
              "key": "report",
              "emoji": "⚠️",
              "label": "Reportar falla"
            }
          ],
          "free_text": "Puedes mandar foto/video y decirme dónde está el problema."
        },
        {
          "key": "first_value",
          "message": "TORO no marca algo como listo solo por un mensaje; cuando aplique, te pedirá la evidencia necesaria para cerrar.",
          "completion": "maintenance_first_action_attempted"
        }
      ],
      "after_first_value": [
        "maintenance.priorities",
        "maintenance.my_tasks",
        "maintenance.close_with_evidence"
      ]
    },
    "specialist_office": {
      "applies_to": [
        "CONTABILIDAD",
        "RRHH",
        "GROWTH",
        "SYSTEMS"
      ],
      "purpose": "Start from domain exceptions rather than expose the whole platform.",
      "steps": [
        {
          "key": "welcome",
          "message": "Hola, {first_name}. TORO ya conoce tu contexto de trabajo y te lleva primero a las excepciones que necesitan atención.",
          "prompt": "¿Qué quieres revisar primero?",
          "dynamic_choices": "top_3_allowed_domain_actions"
        },
        {
          "key": "first_value",
          "message": "Después de la primera tarea, puedes fijar tus accesos rápidos y TORO irá ordenando el menú por uso real.",
          "completion": "specialist_first_action_attempted"
        }
      ],
      "after_first_value": "role_toolbox_top_actions"
    },
    "employee_general": {
      "applies_to": [
        "EMPLEADO"
      ],
      "purpose": "Give a fallback employee experience when no position-specific journey exists.",
      "steps": [
        {
          "key": "welcome",
          "message": "Hola, {first_name} 👋 Esto es lo tuyo para hoy. Puedes usar TORO sin aprender menús largos.",
          "prompt": "¿Qué necesitas?",
          "choices": [
            {
              "key": "day",
              "emoji": "☀️",
              "label": "Mi día"
            },
            {
              "key": "tasks",
              "emoji": "✅",
              "label": "Mis tareas"
            },
            {
              "key": "schedule",
              "emoji": "🗓️",
              "label": "Mi horario"
            }
          ]
        },
        {
          "key": "first_value",
          "message": "Siempre puedes escribir lo que necesitas o volver con “menú”.",
          "completion": "employee_first_action_attempted"
        }
      ],
      "after_first_value": [
        "people.my_day",
        "operations.my_tasks",
        "people.my_schedule"
      ]
    },
    "guest_first_contact": {
      "applies_to": [
        "guest_or_prospect"
      ],
      "purpose": "Make the first guest contact feel human and immediately useful rather than like account onboarding.",
      "steps": [
        {
          "key": "welcome",
          "message": "¡Hola! Soy Tere 😊 Cuéntame qué estás buscando y te lo hago fácil.",
          "prompt": "Puedes empezar por aquí:",
          "choices": [
            {
              "key": "stay",
              "emoji": "🏡",
              "label": "Buscar alojamiento"
            },
            {
              "key": "quote",
              "emoji": "💵",
              "label": "Cotizar"
            },
            {
              "key": "other",
              "emoji": "💬",
              "label": "Preguntar otra cosa"
            }
          ],
          "free_text": "O escríbeme directo, como si estuvieras hablando con recepción."
        }
      ],
      "after_first_value": [
        "hospitality.search_stay",
        "hospitality.quote",
        "guest.ask"
      ]
    }
  }
}
