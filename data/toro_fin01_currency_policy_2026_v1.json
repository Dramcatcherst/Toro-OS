  "eventPolicies": [
    {
      "eventType": "SALES_OR_PURCHASE_DOCUMENT",
      "preserveOriginal": true,
      "ratePurpose": "DOCUMENT_AND_FISCAL_SEPARATE",
      "rule": "Keep native document amount/currency/rate. For Costa Rican VAT base in a foreign currency, use the BCCR reference selling rate effective at the taxable event, after accountant validation; never replace it with a bank or commercial rate."
    },
    {
      "eventType": "PAYMENT_OR_COLLECTION",
      "preserveOriginal": true,
      "ratePurpose": "SETTLEMENT",
      "rule": "Keep paid amount/currency and the actual bank or processor rate and fees. Do not overwrite the invoice rate; route any exchange difference for accountant review."
    },
    {
      "eventType": "BANK_EXCHANGE_OR_TRANSFER",
      "preserveOriginal": true,
      "ratePurpose": "TREASURY_SETTLEMENT",
      "rule": "Use the provider-confirmed execution rate, gross amounts and fees for reconciliation; this rate does not replace the fiscal rate."
    },
    {
      "eventType": "PMS_RESERVATION_OR_COMMERCIAL_QUOTE",
      "preserveOriginal": true,
      "ratePurpose": "COMMERCIAL",
      "rule": "Keep contract currency and guest-facing totals. Kross or OTA data is not bank settlement or fiscal posting evidence."
    },
    {
      "eventType": "MANAGEMENT_PRESENTATION",
      "preserveOriginal": true,
      "ratePurpose": "ANALYTICAL",
      "rule": "A presentation conversion is optional and must carry source/date/purpose; it never replaces ledger values or supports an accounting posting."
    },
    {
      "eventType": "HISTORICAL_NATIVE_RECORD",
      "preserveOriginal": true,
      "ratePurpose": "AS_RECORDED",
      "rule": "Preserve the native historical rate, including an observed 500, and flag missing provenance. Do not backfill or reinterpret without separately approved correction evidence."
    },
    {
      "eventType": "UNKNOWN_CURRENCY_OR_RATE",
      "preserveOriginal": true,
      "ratePurpose": "NONE",
      "rule": "Set PENDING_EVIDENCE and do not convert, aggregate across currencies, post or close the period."
    }
  ],
